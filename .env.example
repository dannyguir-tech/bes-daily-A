# Anthropic API key for AI analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# How often to check for alerts (cron expression, default: every 15 minutes)
CRON_SCHEDULE="*/15 * * * *"

# Polymarket settings
POLY_MIN_BUY_SIZE=500        # Minimum buy size in USD to flag (default: $500)
POLY_TRADE_LOOKBACK_MINS=15  # How far back to look for trades (default: 15 mins)

# Crypto settings
CRYPTO_IDS=bitcoin,ethereum,solana,chainlink,uniswap
CRYPTO_PRICE_CHANGE_THRESHOLD=3  # % change threshold to flag (default: 3%)

# Alert output: "console" (default) or "file"
ALERT_OUTPUT=console
ALERT_LOG_FILE=alerts.log
