# Anthropic API key for AI analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_CALLS_PER_HOUR=20

# How often to check for alerts (cron expression, default: every 15 minutes)
CRON_SCHEDULE="*/15 * * * *"

# Polymarket settings
POLY_MIN_BUY_SIZE=500        # Minimum buy size in USD to flag (default: $500)
POLY_TRADE_LOOKBACK_MINS=15  # How far back to look for trades (default: 15 mins)

# Crypto settings
CRYPTO_IDS=bitcoin,ethereum,solana,chainlink,uniswap
CRYPTO_PRICE_CHANGE_THRESHOLD=3  # % change threshold to flag (default: 3%)

# Alert output: "console" (default) or "file"
ALERT_OUTPUT=console
ALERT_LOG_FILE=alerts.log

# ── Quantitative Engine (Python) ─────────────────────────────────────────────
# Symbols to monitor (Binance USDT pairs)
QUANT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,UNIUSDT

# How often to run the signal engine (seconds, default: 300 = 5 min)
QUANT_INTERVAL_SECS=300

# Regime detection
QUANT_ATR_VOL_THRESHOLD=0.035   # ATR/close above this → UNCERTAIN (no trades)

# Trade scoring gate (0–100); only signals >= threshold proceed to ML filter
QUANT_SCORE_THRESHOLD=70

# XGBoost ML filter gate; only signals with P(success) >= threshold are traded
QUANT_ML_PROB_THRESHOLD=0.6

# ML model directory (where trained XGBoost models are saved)
ML_MODEL_DIR=quant/models/saved/

# Days of history to fetch for ML bootstrap training on first run
ML_BOOTSTRAP_DAYS=90

# Enable/disable ML filter (true/false); if false, score gate alone is used
ML_ENABLED=true

# Risk management
QUANT_ATR_STOP_MULT=1.75        # Stop loss = entry ± ATR_STOP_MULT × ATR
QUANT_ATR_TP_MULT=2.5           # Take profit = entry ± ATR_TP_MULT × ATR
QUANT_KELLY_FRACTION=0.25       # Fractional Kelly (0.25 = quarter Kelly)
QUANT_MAX_HOLD_MINUTES=240      # Exit if no PnL after this many minutes

# Shared log file (quant engine appends to same file as Node.js alerts)
QUANT_LOG_FILE=alerts.log
